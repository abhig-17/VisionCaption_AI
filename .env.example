# Fine-grained token: enable "Make calls to Inference Providers"
# https://huggingface.co/settings/tokens/new?ownUserPermissions=inference.serverless.write&tokenType=fineGrained
VITE_HF_API_TOKEN=hf_your_token_here 

# Optional. Vite proxies /api-hf → router.huggingface.co (avoids CORS in dev).
# VITE_HF_INFERENCE_BASE_URL=https://router.huggingface.co

# Optional. Vision model for /v1/chat/completions (must be on an Inference Provider).
# VITE_HF_VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct

# --- Render.com ---
# Use a Web Service (not Static Site). In Render → Environment, add at least VITE_HF_API_TOKEN
# before build. Leave VITE_HF_INFERENCE_BASE_URL unset so the app uses /api-hf (proxied by server.mjs).
